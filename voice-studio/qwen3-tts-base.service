[Unit]
Description=Pithagoras TTS - Qwen3-TTS 1.7B-Base voice-clone engine (CPU, option A, 2026-10-06)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
WorkingDirectory=/opt/qwen3-tts
Environment=PYTHONPATH=/opt/qwen3-tts/venv/lib/python3.10/site-packages
Environment=PORT=7869
Environment=HOST=127.0.0.1
Environment=TTS_BACKEND=official
Environment=TTS_MODEL_ID=/opt/qwen3-tts/models/Qwen3-TTS-12Hz-1.7B-Base
Environment=TTS_DEVICE=cpu
Environment=TTS_DTYPE=auto
Environment=TTS_ATTN=sdpa
Environment=TTS_LAZY_LOAD=false
Environment=TTS_WARMUP_ON_START=true
Environment=VOICE_LIBRARY_DIR=/opt/qwen3-tts/voice_library
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
StandardOutput=append:/var/log/qwen3-tts-base.log
StandardError=append:/var/log/qwen3-tts-base.log
ExecStart=/opt/qwen3-tts/venv/bin/python -m api.main
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
